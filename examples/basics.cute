# basics.cute - the operators and their order (every answer is 67!)
# Run with:  python main.py examples/basics.cute

print "--- Every operator ---"
print "60 + 7             =", 60 + 7
print "100 - 33           =", 100 - 33
print "134 * 0.5          =", 134 * 0.5
print "134 / 2            =", 134 / 2
print "167 % 100          =", 167 % 100
print "8 ^ 2 + 3          =", 8 ^ 2 + 3

print "--- Order of operations ---"
print "7 + 6 * 10         =", 7 + 6 * 10
print "(10 - 3) * 10 - 3  =", (10 - 3) * 10 - 3
print "2 ^ 3 ^ 2 / 8 + 3  =", 2 ^ 3 ^ 2 / 8 + 3
print "-2 ^ 2 + 71        =", -2 ^ 2 + 71
print "(-2) ^ 2 + 63      =", (-2) ^ 2 + 63
print "100 - 20 - 13      =", 100 - 20 - 13

print "--- Big whole numbers stay exact ---"
print "67 ^ 20 =", 67 ^ 20
